      - SN1
      - SN2
      - elimination
      - primary halogenoalkane
      - secondary halogenoalkane
      - tertiary halogenoalkane
      - hydrolysis
      - silver nitrate
      - leaving group
      - carbon-halogen bond strength

  # ── Chapter 17 (taught 8th) ─────────────────────────────────────────────────
  - id: chem.alcohols
    title: Alcohols
    teaching_order: 8
    coursebook_chapter: 17
    syllabus_topic: "16"
    drive_folder_name: "8. Alcohols (Chapter 17)"
    verified: false
    aliases: [hydroxy compounds, alcohol]
    keywords:
      - alcohol
      - hydroxyl
      - primary alcohol
      - secondary alcohol
      - tertiary alcohol
      - oxidation
      - acidified potassium dichromate
      - distillation
      - reflux
      - esterification
      - dehydration
      - tri-iodomethane test

  - id: chem.carboxylic_acids_esters
    title: Carboxylic Acids & Esters
    teaching_order: 10
    coursebook_chapter: 17
    syllabus_topic: "18"
    drive_folder_name: "10. Carboxylic Acids & Esters (Chapter 17)"
    verified: false
    aliases: [carboxylic acids, esters, acids and esters]
    keywords:
