# Cambridge International AS Level Chemistry 9701
#
# ⚠️  THIS IS A WORKING TEMPLATE, NOT A VERIFIED SYLLABUS.
#
# The chapter structure and Drive folder names below were derived from the
# folder listing you provided, which follows the Cambridge International AS &
# A Level Chemistry Coursebook chapter numbering. Titles, keywords and aliases
# are reliable. Learning-outcome codes and text are NOT — they are marked
# `verified: false` and must be checked against your actual syllabus PDF
# (`Data Section 9701-2025-2027-syllabus.pdf`, in your "2. Syllabus" folder)
# before production use. The loader warns loudly about unverified nodes.
#
#   python scripts/ingest_syllabus.py --pdf <path> --out <this file>
#
# ── On the three numbering systems ────────────────────────────────────────────
# Your folders carry two different numbers, and neither is the syllabus topic:
#
#   "3. Chemical Bonding (Chapter 4)"      → 3rd in teaching order, coursebook ch.4
#   "4. Moles and Stoichiometry (Chapter 3)" → 4th in teaching order, coursebook ch.3
#
# They are transposed relative to each other. So all three are stored as
# independent fields and none is ever derived from another. See
# docs/DECISIONS.md ADR-013.

version: 1
subject_id: as_chemistry
subject_name: AS Chemistry
syllabus_code: "9701"
syllabus_years: "2025-2027"
awarding_body: Cambridge International
source: "Derived from observed Drive folder structure; outcomes pending verification"

# Vocabulary primed into the ASR decoder for every lecture in this subject, in
# addition to per-node keywords. These are the terms generic speech recognition
# reliably mangles.
subject_vocabulary:
  - stoichiometry
  - Avogadro
  - electronegativity
  - halogenoalkane
  - nucleophilic
  - electrophilic
  - enthalpy
  - Le Chatelier
  - equilibrium
  - isotope
  - orbital
  - covalent
  - ionic
  - dative
  - hybridisation
  - homologous
  - isomerism
  - titration
  - molarity
  - oxidation

nodes:
  # ── Introduction ────────────────────────────────────────────────────────────
  - id: chem.introduction
    title: Introduction
    teaching_order: 0
    coursebook_chapter: null
    syllabus_topic: null
    drive_folder_name: "0. Introduction"
    verified: true
    aliases: [orientation, course intro, first class, welcome]
    keywords: [syllabus, assessment, exam structure, paper 1, paper 2, grading]
    # Admin sessions rather than teaching. Excluded from classification so an
    # intro lecture doesn't absorb genuine content.
    exclude_from_classification: true

  # ── Chapter 1 ───────────────────────────────────────────────────────────────
  - id: chem.atomic_structure
    title: Atomic Structure
    teaching_order: 1
    coursebook_chapter: 1
    syllabus_topic: "1"
    drive_folder_name: "1. Atomic Structure (Chapter 1)"
    verified: false
    aliases:
      - structure of the atom
      - AOD                       # teacher shorthand seen in your own filenames
      - atomic orbital diagram
      - subatomic particles
    keywords:
      - proton
      - neutron
      - electron
      - nucleus
      - nucleon number
      - proton number
      - mass number
      - atomic number
      - isotope
      - relative charge
      - relative mass
      - behaviour in an electric field
    learning_outcomes:
      - code: "1.1"
        text: "Identify and describe protons, neutrons and electrons in terms of their relative charges and relative masses"
        verified: false
      - code: "1.2"
        text: "Deduce the behaviour of beams of protons, neutrons and electrons in electric fields"
        verified: false
      - code: "1.3"
        text: "Describe the distribution of mass and charge within an atom"
        verified: false
    children:
      - id: chem.atomic_structure.rel_atomic_mass
        title: Relative Atomic Mass
        verified: false
        aliases: [RAM, Ar, relative masses, average atomic mass]
        keywords:
          - relative atomic mass
          - relative isotopic mass
          - carbon-12
          - weighted average
          - weighted mean
          - abundance
          - mass spectrum
          - mass spectrometer
        learning_outcomes:
          - code: "1.4"
            text: "Define and use relative atomic mass and relative isotopic mass, based on the 12C scale"
            verified: false

      - id: chem.atomic_structure.isotopes
        title: Isotopes
        verified: false
        aliases: [isotopic]
        keywords: [isotope, same proton number, different neutron number,
                   chemical properties identical, physical properties differ]

  # ── Chapter 2 ───────────────────────────────────────────────────────────────
  - id: chem.electrons_in_atoms
    title: Electrons in Atoms
    teaching_order: 2
    coursebook_chapter: 2
    syllabus_topic: "1"
    drive_folder_name: "2. Electrons in Atoms (Chapter 2)"
    verified: false
    aliases: [electronic configuration, electron structure, electronic structure]
    keywords:
      - electronic configuration
      - shell
      - subshell
      - orbital
      - s orbital
      - p orbital
      - d orbital
      - principal quantum number
      - ionisation energy
      - first ionisation energy
      - successive ionisation energies
      - shielding
      - nuclear attraction
      - Hund
      - Pauli
      - aufbau
    learning_outcomes:
      - code: "1.5"
        text: "Describe the number and relative energies of the s, p and d orbitals"
        verified: false
      - code: "1.6"
        text: "Describe and sketch the shapes of s and p orbitals"
        verified: false
      - code: "1.7"
        text: "Define and explain trends in first ionisation energy"
        verified: false
    children:
      - id: chem.electrons_in_atoms.ionisation_energy
        title: Ionisation Energy
        verified: false
        aliases: [IE, ionization energy]
        keywords: [first ionisation energy, successive ionisation energy,
                   evidence for shells, big jump, gaseous atoms, endothermic]

  # ── Chapter 3 (taught 4th) ──────────────────────────────────────────────────
  - id: chem.moles_stoichiometry
    title: Moles and Stoichiometry
    teaching_order: 4
    coursebook_chapter: 3
    syllabus_topic: "2"
    drive_folder_name: "4. Moles and Stoichiometry (Chapter 3)"
    verified: false
    aliases: [moles, stoichiometry, calculations, mole concept, amount of substance]
    keywords:
      - mole
      - Avogadro constant
      - molar mass
      - empirical formula
      - molecular formula
      - percentage yield
      - limiting reagent
      - concentration
      - molar volume
      - ideal gas equation
      - titration
      - molarity
      - balanced equation
      - relative molecular mass
    learning_outcomes:
      - code: "2.1"
        text: "Define and use the terms relative formula mass, mole and the Avogadro constant"
        verified: false
      - code: "2.2"
        text: "Write and construct balanced equations, including ionic equations"
        verified: false
      - code: "2.3"
        text: "Perform calculations involving reacting masses, volumes of gases and solutions"
        verified: false

  # ── Chapter 4 (taught 3rd) ──────────────────────────────────────────────────
  - id: chem.chemical_bonding
    title: Chemical Bonding
    teaching_order: 3
    coursebook_chapter: 4
    syllabus_topic: "3"
    drive_folder_name: "3. Chemical Bonding (Chapter 4)"
    verified: false
    aliases: [bonding, chemical bonds, structure and bonding]
    keywords:
      - ionic bond
      - covalent bond
      - dative covalent
      - coordinate bond
      - metallic bond
      - lone pair
      - bond pair
      - electronegativity
      - polarity
      - dipole
      - intermolecular force
      - van der Waals
      - hydrogen bonding
      - VSEPR
      - bond angle
      - shape of molecules
      - sigma bond
      - pi bond
      - hybridisation
    learning_outcomes:
      - code: "3.1"
        text: "Describe ionic bonding as the electrostatic attraction between oppositely charged ions"
        verified: false
      - code: "3.2"
        text: "Describe covalent bonding, including dative covalent (coordinate) bonding"
        verified: false
      - code: "3.3"
        text: "Use VSEPR theory to predict and explain the shapes of and bond angles in molecules"
        verified: false

  # ── Chapter 5 ───────────────────────────────────────────────────────────────
  - id: chem.states_of_matter
    title: States of Matter
    teaching_order: 5
    coursebook_chapter: 5
    syllabus_topic: "4"
    drive_folder_name: "5. States of Matter (Chapter 5)"
    verified: false
    aliases: [states, gases liquids solids, kinetic theory]
    keywords:
      - ideal gas
      - real gas
      - kinetic theory
      - pV = nRT
      - lattice
      - giant ionic
      - simple molecular
      - giant covalent
      - metallic lattice
      - graphite
      - diamond
      - melting point
      - boiling point
    learning_outcomes:
      - code: "4.1"
        text: "State the basic assumptions of the kinetic theory as applied to an ideal gas"
        verified: false
      - code: "4.2"
        text: "Describe, in simple terms, the lattice structures of ionic, simple molecular, giant covalent and metallic solids"
        verified: false

  # ── Chapter 14 ──────────────────────────────────────────────────────────────
  - id: chem.intro_organic
    title: Intro to Organic Chemistry
    teaching_order: 6
    coursebook_chapter: 14
    syllabus_topic: "13"
    drive_folder_name: "6. Intro to Organic Chemistry (Chapter 14)"
    verified: false
    aliases: [organic chemistry basics, introduction to organic, nomenclature]
    keywords:
      - homologous series
      - functional group
      - nomenclature
      - IUPAC
      - structural formula
      - displayed formula
      - skeletal formula
      - general formula
      - isomerism
      - structural isomerism
      - stereoisomerism
      - cis-trans
      - optical isomerism
      - chiral
      - free radical
      - nucleophile
      - electrophile
      - homolytic
      - heterolytic
      - curly arrow
    learning_outcomes:
      - code: "13.1"
        text: "Interpret and use the general, structural, displayed and skeletal formulae of organic molecules"
        verified: false
      - code: "13.2"
        text: "Understand and use systematic nomenclature of simple organic compounds"
        verified: false

  # ── Chapter 15 ──────────────────────────────────────────────────────────────
  - id: chem.hydrocarbons
    title: Hydrocarbons
    teaching_order: 7
    coursebook_chapter: 15
    syllabus_topic: "14"
    drive_folder_name: "7. Hydrocarbons (Chapter 15)"
    verified: false
    aliases: [alkanes and alkenes, alkanes, alkenes]
    keywords:
      - alkane
      - alkene
      - saturated
      - unsaturated
      - free radical substitution
      - electrophilic addition
      - Markovnikov
      - bromine water
      - cracking
      - combustion
      - polymerisation
      - addition polymer
      - double bond
      - carbocation
    children:
      - id: chem.hydrocarbons.alkanes
        title: Alkanes
        verified: false
        keywords: [alkane, free radical substitution, initiation, propagation,
                   termination, UV light, cracking, combustion]
      - id: chem.hydrocarbons.alkenes
        title: Alkenes
        verified: false
        keywords: [alkene, electrophilic addition, Markovnikov, carbocation
                   stability, bromine water, addition polymerisation]

  # ── Chapter 16 (taught 9th) ─────────────────────────────────────────────────
  - id: chem.halogenoalkanes
    title: Halogenoalkanes
    teaching_order: 9
    coursebook_chapter: 16
    syllabus_topic: "15"
    drive_folder_name: "9. Halogenoalkanes (Chapter 16)"
    verified: false
    aliases: [haloalkanes, halogen compounds, alkyl halides]
    keywords:
      - halogenoalkane
