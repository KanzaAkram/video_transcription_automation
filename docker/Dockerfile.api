# Webhook receiver and admin API.
#
# Small and always-on: it must be publicly reachable over HTTPS for Zoom and
# Drive to deliver notifications. It never transcribes and never blocks —
# see docs/ARCHITECTURE.md § 2.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir -e ".[api,cloud,classify,queue]"

COPY config/ config/

# Run unprivileged: this is the only component exposed to the internet.
RUN useradd --create-home --uid 10001 appuser && chown -R appuser /app
USER appuser

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8080/health').status==200 else 1)"

CMD ["uvicorn", "pipeline.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
