# Pipeline worker.
#
# Serves both queues; which one is chosen at runtime via --queues:
#   io   network-bound (download, Drive, LLM). High concurrency, no GPU.
#   gpu  transcription only. Concurrency must equal the number of GPUs.
#
# For GPU hosts, swap the base image for an NVIDIA CUDA runtime image and run
# with `--gpus all`. Python is pinned below 3.14 because ctranslate2 and torch
# wheels lag new CPython releases.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# ffmpeg is required for audio extraction; the worker fails fast without it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir -e ".[cloud,asr,classify,embeddings,queue]"

COPY config/ config/

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/media_cache /app/data \
    && chown -R appuser /app
USER appuser

# Overridden by docker-compose per queue.
CMD ["celery", "-A", "pipeline.orchestration.tasks", "worker", \
     "--loglevel=INFO", "--queues=io", "--concurrency=8"]
