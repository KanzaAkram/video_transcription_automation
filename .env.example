# Copy to .env and fill in. .env is gitignored — never commit real values.
# Every variable here is optional in dry-run mode; see docs/SETUP.md for how to
# obtain each one when you are ready to connect the real accounts.

# ── Core ──────────────────────────────────────────────────────────────────────
PIPELINE_ENV=dev                      # dev | staging | prod
PIPELINE_SETTINGS_FILE=config/settings.yaml
LOG_LEVEL=INFO

# ── Google Drive ──────────────────────────────────────────────────────────────
# Pick ONE auth mode. See docs/SETUP.md § Google Drive for which applies to you.
#   service_account  — Google Workspace + Shared Drive (recommended)
#   impersonation    — Google Workspace + domain-wide delegation
#   oauth_user       — personal Gmail account (refresh token)
GOOGLE_AUTH_MODE=service_account
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_IMPERSONATE_SUBJECT=                 # impersonation mode only
GOOGLE_OAUTH_CLIENT_ID=                     # oauth_user mode only
GOOGLE_OAUTH_CLIENT_SECRET=                 # oauth_user mode only
GOOGLE_OAUTH_REFRESH_TOKEN=                 # oauth_user mode only

# Root of the managed tree, e.g. the folder containing "5. AS Chemistry".
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Folder that Zoom recordings land in before processing.
GOOGLE_DRIVE_INBOX_FOLDER_ID=
# Where low-confidence results are parked for a human to check.
GOOGLE_DRIVE_REVIEW_FOLDER_ID=
# Shared Drive id, if the tree lives on a Shared Drive rather than My Drive.
GOOGLE_SHARED_DRIVE_ID=

# ── Zoom ──────────────────────────────────────────────────────────────────────
# Server-to-Server OAuth app (JWT apps were retired in 2023).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# From the app's Event Subscription — used to verify webhook signatures.
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Classification (ChatGPT) ──────────────────────────────────────────────────
# The one key the renamer needs. https://platform.openai.com/api-keys
# Which model and how hard it thinks are behaviour, so they live in
# config/settings.yaml under `classify:` rather than here.
OPENAI_API_KEY=

# Only for `classify.provider: anthropic`, the earlier Claude path.
ANTHROPIC_API_KEY=

# ── Datastore + queue ─────────────────────────────────────────────────────────
# SQLite is fine below ~50 lectures/week; move to Postgres above that.
DATABASE_URL=sqlite+aiosqlite:///data/pipeline.db
REDIS_URL=redis://localhost:6379/0

# ── Notifications (optional) ──────────────────────────────────────────────────
NOTIFY_CHANNEL=none                   # none | email | slack
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
SMTP_URL=

# ── Public URL of this service, for registering webhooks ──────────────────────
PUBLIC_BASE_URL=https://lectures.example.com
